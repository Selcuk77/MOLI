SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SITE_URL=https://moli-orcin.vercel.app

# Optional: AI Gateway. Choose an available model in the Vercel AI Gateway catalog.
# AI_MODEL=provider/model-id
# AI_GATEWAY_API_KEY=enter-directly-in-vercel-or-use-vercel-oidc

# Optional: reminder delivery. Enable only AFTER configuring a once-per-minute scheduler.
# REMINDERS_ENABLED=true
# CRON_SECRET=long-random-secret
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-public
# RESEND_API_KEY=server-only
# REMINDER_FROM=MOLI <verified-sender@your-domain>
# TWILIO_ACCOUNT_SID=server-only
# TWILIO_AUTH_TOKEN=server-only
# TWILIO_VERIFY_SERVICE_SID=server-only
# TWILIO_FROM=your-approved-sender
